{
  "version": 1,
  "hooks": {
    "PostToolUse": [
      {
        "type": "command",
        "command": "./scripts/log-lesson.sh",
        "timeout": 10
      }
    ],
    "ErrorOccurred": [
      {
        "type": "command",
        "command": "./scripts/log-lesson.sh",
        "timeout": 10
      }
    ],
    "SessionStart": [
      {
        "type": "command",
        "command": "./scripts/inject-lessons.sh",
        "timeout": 10
      }
    ]
  }
}
