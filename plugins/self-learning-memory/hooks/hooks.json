{
  "version": 1,
  "hooks": {
    "PostToolUse": [
      {
        "type": "command",
        "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/log-lesson.sh\"",
        "timeout": 10
      }
    ],
    "ErrorOccurred": [
      {
        "type": "command",
        "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/log-lesson.sh\"",
        "timeout": 10
      }
    ],
    "SessionStart": [
      {
        "type": "command",
        "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/inject-lessons.sh\"",
        "timeout": 10
      }
    ]
  }
}
