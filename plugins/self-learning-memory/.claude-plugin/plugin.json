{
  "name": "self-learning-memory",
  "description": "Self-learning memory: logs failed tool calls, distills them into caveman lessons, injects at session start. Includes memory-hygiene skill.",
  "version": "0.1.0",
  "author": {
    "name": "Kyler Jensen"
  },
  "homepage": "https://github.com/kylerjensen/copilot-plugins/tree/main/plugins/self-learning-memory",
  "repository": "https://github.com/kylerjensen/copilot-plugins",
  "license": "MIT",
  "keywords": ["memory", "hooks", "lessons", "self-learning", "copilot-cli"],
  "skills": ["skills/"],
  "hooks": {
    "PostToolUse": [
      {
        "type": "command",
        "bash": "\"${CLAUDE_PLUGIN_ROOT}/scripts/log-lesson.sh\"",
        "timeoutSec": 10
      }
    ],
    "ErrorOccurred": [
      {
        "type": "command",
        "bash": "\"${CLAUDE_PLUGIN_ROOT}/scripts/log-lesson.sh\"",
        "timeoutSec": 10
      }
    ],
    "SessionStart": [
      {
        "type": "command",
        "bash": "\"${CLAUDE_PLUGIN_ROOT}/scripts/inject-lessons.sh\"",
        "timeoutSec": 10
      }
    ]
  }
}
